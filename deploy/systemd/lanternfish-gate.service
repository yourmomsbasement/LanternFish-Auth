[Unit]
Description=Lanternfish Gate (authenticating proxy for Jellyfin)
Documentation=https://github.com/yourmomsbasement/LanternFish-Auth
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lanternfish
Group=lanternfish
EnvironmentFile=/etc/lanternfish/gate.env
ExecStart=/usr/local/bin/lanternfish-gate serve
Restart=on-failure
RestartSec=5

StateDirectory=lanternfish
StateDirectoryMode=0700
UMask=0077

# Bind :443 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Hardening. In a Proxmox LXC these need nesting=1 (the default for new
# unprivileged containers). If the service fails with status=226/NAMESPACE,
# that's the cause.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
