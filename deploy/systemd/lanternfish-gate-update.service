[Unit]
Description=Lanternfish Gate updater (installs signed releases)
Documentation=https://github.com/yourmomsbasement/LanternFish-Auth/blob/main/docs/RELEASES.md
After=network-online.target
Wants=network-online.target

# Runs as root because it replaces the Gate's binary and restarts it. It
# trusts only releases whose manifest is signed by a key in
# /etc/lanternfish/release-keys, and rolls back if the new Gate is unhealthy.
[Service]
Type=oneshot
EnvironmentFile=/etc/lanternfish/gate.env
ExecStart=/usr/local/bin/lanternfish-gate update run-request
TimeoutStartSec=15min

StateDirectory=lanternfish-update
StateDirectoryMode=0755
UMask=0022
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/usr/local/bin /usr/local/lib/lanternfish /var/lib/lanternfish
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
