# /etc/lanternfish/gate.env: settings for lanternfish-gate.service.
# Run `lanternfish-gate help` for the full list.

LANTERNFISH_LISTEN=:443
LANTERNFISH_UPSTREAM=http://10.20.0.3:8096

LANTERNFISH_TLS_CERT=/etc/lanternfish/tls/fullchain.pem
LANTERNFISH_TLS_KEY=/etc/lanternfish/tls/privkey.pem

# On a host bind mount that is never included in Proxmox backups.
LANTERNFISH_MASTER_KEY_FILE=/etc/lanternfish/keys/master_key

LANTERNFISH_DATA=/var/lib/lanternfish/gate.json
LANTERNFISH_AUDIT_LOG=/var/lib/lanternfish/audit.log

# Where the admin API (used by Lanternfish Builder) answers from. Narrow this
# to your Builder PC, e.g. 192.168.1.10. Add 100.64.0.0/10 for Tailscale.
LANTERNFISH_ADMIN_ALLOW=192.168.1.0/24

# SECURITY: serve the admin dashboard on its own port, which browsers treat
# as a separate origin from Jellyfin. Without it, a script running in
# Jellyfin's web client (a malicious plugin, theme or stored XSS) in your
# browser could use your dashboard session. Open this port only to your
# admin PC, then use https://<gate>:9443/_lanternfish/admin/.
LANTERNFISH_ADMIN_LISTEN=:9443

# The Gate adds a session-renewal script to Jellyfin's web client for browsers,
# unless the Jellyfin plugin already did. Set to false to turn that off.
#LANTERNFISH_INJECT_RENEWAL=true

# Ping on every enrollment and revocation (Discord webhook URL or compatible).
#LANTERNFISH_ALERT_WEBHOOK=https://discord.com/api/webhooks/...

# Updates (docs/RELEASES.md). The dashboard's Updates tab installs releases
# signed by a key in /etc/lanternfish/release-keys. Set this to also install
# them automatically each night: patch (x.y.Z), minor (x.Y.z) or all.
#LANTERNFISH_AUTO_UPDATE=off

# Passkeys (WebAuthn) for owners approving sign-ins: the public hostname, and
# the exact https origin(s) browsers use. Leave unset to turn passkeys off.
#LANTERNFISH_WEBAUTHN_RP_ID=flix.example.com
#LANTERNFISH_WEBAUTHN_ORIGINS=https://flix.example.com
#LANTERNFISH_WEBAUTHN_RP_NAME=Lanternfish
# Cache file for the FIDO metadata service; enables "only certified models".
#LANTERNFISH_WEBAUTHN_MDS=/var/lib/lanternfish/fido-mds.json

# Country rules: a local GeoLite2-Country (or GeoIP2-Country) database,
# kept current with MaxMind's geoipupdate. Lookups never leave this machine.
#LANTERNFISH_GEOIP_DB=/var/lib/GeoIP/GeoLite2-Country.mmdb
# Older than this, lookups count as "unknown".
#LANTERNFISH_GEOIP_MAX_AGE=1080h

# Rotate the audit log at this size, keeping 3 old files.
#LANTERNFISH_AUDIT_MAX_MB=20

# Optional internal Jellyfin backend route. Leave all three unset to disable.
# See docs/MEDIA-STACK.md and docs/OPTIONAL-HARDENING.md before enabling it.
#LANTERNFISH_SERVICE_NETWORK=10.20.0.0/24
#LANTERNFISH_SERVICE_LISTEN=10.20.0.2:8096
#LANTERNFISH_SERVICE_CLIENTS=seerr=10.20.0.4
# Or use the JSON file for per-service permissions, limits and revocation.
# Do not set SERVICE_CLIENTS and SERVICE_CLIENTS_FILE together.
#LANTERNFISH_SERVICE_CLIENTS_FILE=/etc/lanternfish/service-clients.json

# Optional mTLS; ip is the compatibility default. All TLS files are required
# in mtls mode. Client certificate URI identity and exact source IP must match.
#LANTERNFISH_SERVICE_AUTH=mtls
#LANTERNFISH_SERVICE_TLS_CERT=/etc/lanternfish/tls/service-server.pem
#LANTERNFISH_SERVICE_TLS_KEY=/etc/lanternfish/tls/service-server-key.pem
#LANTERNFISH_SERVICE_CLIENT_CA=/etc/lanternfish/tls/service-client-ca.pem

# Optional per-service defaults; client JSON nonzero limits override these.
# Zero limits mean unlimited; the request timeout defaults to 2m.
#LANTERNFISH_SERVICE_MAX_CONCURRENT=2
#LANTERNFISH_SERVICE_REQUESTS_PER_MINUTE=120
#LANTERNFISH_SERVICE_MAX_BODY_BYTES=1048576
#LANTERNFISH_SERVICE_TIMEOUT=2m

# Optional alerts require ALERT_WEBHOOK above; expiry alerts require mTLS.
# No monitor/schedule is created. Drift checks compare the saved plan/config,
# not the actual running Proxmox firewall. Expiry checks need active requests.
#LANTERNFISH_SERVICE_ALERT_FAILURES=5
#LANTERNFISH_SERVICE_ALERT_WINDOW=5m
#LANTERNFISH_SERVICE_CERT_WARN_BEFORE=168h
#LANTERNFISH_SERVICE_ALERT_CONFIG_DRIFT=true
